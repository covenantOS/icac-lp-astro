---
// Spectrum PPC landing page. Goal 1: tap to call. Goal 2: callback form.
// Section order follows our PPC pattern (True Builders, HD Clean, Westchase):
// hero + form, trust strip, services, real team, steps, owner, reviews,
// brand partner + financing, areas, FAQ, form + call, footer, sticky call.
import LandingLayout from "~/layouts/LandingLayout.astro";
import Icon from "~/components/Icon.astro";
import GoogleLogo from "~/components/GoogleLogo.astro";
import LeadForm from "~/components/ppc/LeadForm.astro";
import {
  biz, img, heroTicks, trustItems, photoServices, moreServices,
  steps, reasons, reviews, areas, neighborhoods, faqs,
} from "~/data/ppc";

const title = "AC Repair Wesley Chapel & Tampa Bay | I Care Air Care";
const description =
  "AC repair, tune-ups and new systems from a family-run Wesley Chapel team. 4.9 stars from 700+ Google reviews. Written quote before any work. Call (813) 395-2324.";

const callBtn =
  "pop-btn pop-btn--primary inline-flex items-center justify-center gap-2.5 rounded-lg bg-[var(--color-accent)] font-bold text-white shadow-lg shadow-orange-900/20 hover:bg-[var(--color-accent-dark)]";
const ghostBtn =
  "pop-btn inline-flex items-center justify-center gap-2 rounded-lg border border-[var(--color-line)] bg-white font-semibold text-[var(--color-navy)] hover:border-[var(--color-brand)]";
const eyebrow = "text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-brand-dark)]";
const h2 = "mt-2 text-3xl font-extrabold leading-tight tracking-tight text-[var(--color-navy)] sm:text-4xl";
const stars = "★★★★★";
---

<LandingLayout title={title} description={description} heroImage={img.team}>
  <!-- Top bar -->
  <div class="hidden bg-[var(--color-navy)] text-[13px] text-white/85 md:block">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-2">
      <div class="flex items-center gap-6">
        <span>{biz.street}, {biz.cityLine}</span>
        <span><span class="text-[var(--color-accent-light)]">{stars}</span> {biz.rating} from {biz.reviews} Google reviews</span>
      </div>
      <span>Licensed {biz.license}</span>
    </div>
  </div>

  <!-- Header: logo + call only. No nav on a PPC page. -->
  <header class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6">
      <img src={img.logo} alt="I Care Air Care Heating & Cooling" width="240" height="136" class="h-11 w-auto sm:h-[54px]" />
      <div class="flex items-center gap-3">
        <span class="hidden text-right text-xs leading-tight text-[var(--color-ink-soft)] lg:block">Talk to our<br />Wesley Chapel office</span>
        <a href={biz.phoneHref} class={`${callBtn} px-4 py-2.5 text-sm sm:px-5 sm:text-base`} data-call="header">
          <Icon name="phone" class="h-4 w-4" />
          <span>{biz.phone}</span>
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section id="top" class="relative isolate overflow-hidden bg-[var(--color-navy-deep)] text-white">
      <img src={img.team} alt="" width="1800" height="1200" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_60%]" fetchpriority="high" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[var(--color-navy-deep)]/95 via-[var(--color-navy)]/85 to-[var(--color-navy)]/55"></div>
      <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1.15fr_0.85fr] lg:py-20">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <a href={biz.googleUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-semibold ring-1 ring-white/20 backdrop-blur">
              <GoogleLogo class="h-4 w-4" />
              <span class="text-[var(--color-accent-light)]">{stars}</span>
              {biz.rating} · {biz.reviews} Google reviews
            </a>
            <span class="rounded-full bg-white px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-navy)]">{biz.years} years of service</span>
          </div>
          <h1 class="mt-6 text-[2.6rem] font-extrabold leading-[1.04] tracking-tight sm:text-6xl">
            <span class="text-[var(--color-accent-light)]">House too hot?</span><br />
            AC repair in Wesley Chapel &amp; Tampa Bay
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85">
            Family-run since {biz.since}. A licensed tech finds the problem and gives you a <strong class="text-white">written price before any work starts</strong>. Every repair is backed for a year.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={biz.phoneHref} class={`${callBtn} px-7 py-4 text-lg`} data-call="hero">
              <Icon name="phone" class="h-5 w-5" />
              Call {biz.phone}
            </a>
            <a href="#callback" class="pop-btn inline-flex items-center justify-center rounded-lg border border-white/40 bg-white/5 px-7 py-4 text-lg font-semibold text-white hover:bg-white/10">
              Request a callback
            </a>
          </div>
          <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/85">
            {heroTicks.map((t) => (
              <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-[var(--color-accent-light)]" />{t}</li>
            ))}
          </ul>
        </div>
        <div class="hidden lg:block">
          <LeadForm formId="hero-form" title="Get a callback" subtitle="Tell us what's going on. We'll call you back during office hours." />
        </div>
      </div>
    </section>

    <!-- Trust strip -->
    <section class="border-b border-[var(--color-line)] bg-white">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-4 gap-y-5 px-4 py-6 sm:px-6 md:grid-cols-5">
        {trustItems.map((t) => (
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-brand-lighter)] text-[var(--color-brand)] ring-1 ring-[var(--color-line)]">
              {t.icon === "google" ? <GoogleLogo class="h-5 w-5" /> : <Icon name={t.icon} class="h-5 w-5" />}
            </span>
            <div class="leading-tight">
              <p class="text-sm font-bold text-[var(--color-navy)]">{t.title}</p>
              <p class="text-xs text-[var(--color-ink-soft)]">{t.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="bg-[var(--color-brand-lighter)] py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class={eyebrow}>What we fix</p>
          <h2 class={h2}>Heating and cooling, start to finish</h2>
          <p class="mt-4 text-[var(--color-ink-soft)]">From a dead capacitor on a 95° afternoon to a full high-efficiency replacement. Every major brand.</p>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {photoServices.map((s) => (
            <article class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-[var(--color-line)]">
              <img src={s.image} alt={s.alt} width="1400" height="933" loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover" />
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-xl font-bold text-[var(--color-navy)]">{s.title}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-[var(--color-ink-soft)]">{s.blurb}</p>
                <ul class="mt-4 space-y-2 text-sm text-[var(--color-ink)]">
                  {s.bullets.map((b) => (
                    <li class="flex gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-brand)]" />{b}</li>
                  ))}
                </ul>
                <a href={biz.phoneHref} class={`${callBtn} mt-6 px-5 py-3 text-base`} data-call="service">
                  <Icon name="phone" class="h-4 w-4" />Call {biz.phone}
                </a>
              </div>
            </article>
          ))}
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {moreServices.map((s) => (
            <div class="flex gap-4 rounded-xl bg-white p-5 ring-1 ring-[var(--color-line)]">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[var(--color-navy)] text-white">
                <Icon name={s.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="font-bold text-[var(--color-navy)]">{s.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-soft)]">{s.blurb}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-8 text-center text-sm text-[var(--color-ink-soft)]">
          We service Carrier, Trane, Lennox, Rheem, Goodman, American Standard, Bryant and Mitsubishi Electric.
        </p>
      </div>
    </section>

    <!-- Real team + spotlight review -->
    <section class="bg-white py-16 sm:py-20">
      <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
        <div class="relative">
          <img src={img.team} alt="The I Care Air Care team in front of their service vans in Wesley Chapel" width="1800" height="1200" loading="lazy" decoding="async" class="w-full rounded-2xl object-cover shadow-lg" />
          <div class="relative -mt-10 ml-4 mr-4 rounded-xl bg-white p-5 shadow-xl ring-1 ring-[var(--color-line)] sm:absolute sm:-bottom-8 sm:right-[-1rem] sm:ml-0 sm:mr-0 sm:mt-0 sm:max-w-sm">
            <p class="text-[var(--color-accent)]">{stars}</p>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink)]">"{reviews[0].text}"</p>
            <p class="mt-2 text-xs font-semibold text-[var(--color-ink-soft)]">{reviews[0].name} · Google review</p>
          </div>
        </div>
        <div class="lg:pl-8">
          <p class={eyebrow}>Your local team</p>
          <h2 class={h2}>Wesley Chapel neighbors, dispatching from Foamflower Blvd</h2>
          <p class="mt-5 leading-relaxed text-[var(--color-ink-soft)]">
            Every truck you see in a Wesley Chapel driveway is our crew, driving minutes from home. Owner {biz.owner} and a local team of trained HVAC technicians handle repair, maintenance and replacement calls across Pasco, Hillsborough and Polk counties.
          </p>
          <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
            {[
              [biz.homes, "Tampa Bay homes served"],
              [biz.years, "Years in service"],
              [biz.reviews, "5-star reviews"],
              ["1 yr", "Repair warranty"],
            ].map(([n, l]) => (
              <div class="rounded-xl bg-[var(--color-brand-lighter)] p-4 text-center ring-1 ring-[var(--color-line)]">
                <dt class="text-2xl font-extrabold text-[var(--color-navy)]">{n}</dt>
                <dd class="mt-1 text-xs leading-tight text-[var(--color-ink-soft)]">{l}</dd>
              </div>
            ))}
          </dl>
          <a href={biz.phoneHref} class={`${callBtn} mt-8 px-6 py-3.5 text-base`} data-call="team">
            <Icon name="phone" class="h-5 w-5" />Call {biz.phone}
          </a>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="bg-[var(--color-navy)] py-16 text-white sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-accent-light)]">How it works</p>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Three steps to a cool house</h2>
        </div>
        <div class="mt-12 grid items-stretch gap-6 lg:grid-cols-[1fr_1fr_1fr_0.9fr]">
          {steps.map((s) => (
            <div class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-accent)] text-lg font-extrabold">{s.n}</span>
              <h3 class="mt-5 text-lg font-bold">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/75">{s.body}</p>
            </div>
          ))}
          <div class="relative h-72 overflow-hidden rounded-2xl ring-1 ring-white/10 lg:h-auto">
            <img src={img.office} alt="I Care Air Care office team member scheduling a service call" width="900" height="1350" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover object-[50%_35%]" />
          </div>
        </div>
        <div class="mt-10 text-center">
          <a href={biz.phoneHref} class={`${callBtn} px-7 py-4 text-lg`} data-call="steps">
            <Icon name="phone" class="h-5 w-5" />Call {biz.phone}
          </a>
        </div>
      </div>
    </section>

    <!-- Owner -->
    <section class="bg-white py-16 sm:py-20">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 md:grid-cols-[0.8fr_1.2fr]">
        <img src={img.tim} alt="Tim Hawk, owner of I Care Air Care" width="900" height="1141" loading="lazy" decoding="async" class="mx-auto w-full max-w-sm rounded-2xl object-cover shadow-lg" />
        <div>
          <p class={eyebrow}>From the owner</p>
          <h2 class={h2}>Meet Tim, founder, master tech and the voice on the phone</h2>
          <p class="mt-5 leading-relaxed text-[var(--color-ink-soft)]">
            Tim Hawk founded I Care Air Care in {biz.since} after 30+ years in the Tampa Bay HVAC trade. He still shows up on the hard calls, the ones that need a master technician, not a parts-swapper.
          </p>
          <p class="mt-4 leading-relaxed text-[var(--color-ink-soft)]">
            When you call, you're talking to people who have been on a rooftop in July diagnosing the same problem you're describing.
          </p>
          <ul class="mt-6 grid gap-2 text-sm font-semibold text-[var(--color-navy)] sm:grid-cols-2">
            <li class="flex items-center gap-2"><Icon name="shield" class="h-5 w-5 text-[var(--color-brand)]" />Florida license {biz.license}</li>
            <li class="flex items-center gap-2"><Icon name="badge" class="h-5 w-5 text-[var(--color-brand)]" />EPA 608 Universal certified</li>
            <li class="flex items-center gap-2"><Icon name="home" class="h-5 w-5 text-[var(--color-brand)]" />Family-owned and operated</li>
            <li class="flex items-center gap-2"><Icon name="thumb" class="h-5 w-5 text-[var(--color-brand)]" />Bonded and insured</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Why us + reviews -->
    <section class="bg-[var(--color-brand-lighter)] py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class={eyebrow}>Local · licensed · family-run since {biz.since}</p>
          <h2 class={h2}>Why Wesley Chapel keeps calling us back</h2>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {reasons.map((r) => (
            <div class="rounded-2xl bg-white p-6 ring-1 ring-[var(--color-line)]">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-accent)]/12 text-[var(--color-accent-dark)]"><Icon name="check" class="h-5 w-5" /></span>
              <h3 class="mt-4 text-lg font-bold text-[var(--color-navy)]">{r.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">{r.body}</p>
            </div>
          ))}
        </div>

        <div class="mt-14 flex flex-col items-center gap-3 text-center">
          <a href={biz.googleUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-3 rounded-full bg-white px-5 py-2.5 shadow-sm ring-1 ring-[var(--color-line)]">
            <GoogleLogo class="h-5 w-5" />
            <span class="text-lg font-extrabold text-[var(--color-navy)]">{biz.rating}</span>
            <span class="text-[var(--color-accent)]">{stars}</span>
            <span class="text-sm text-[var(--color-ink-soft)]">{biz.reviews} Google reviews</span>
          </a>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {reviews.slice(1).concat(reviews.slice(0, 1)).map((r) => (
            <figure class="flex flex-col rounded-2xl bg-white p-6 ring-1 ring-[var(--color-line)]">
              <p class="text-[var(--color-accent)]">{stars}</p>
              <blockquote class="mt-3 flex-1 text-[15px] leading-relaxed text-[var(--color-ink)]">"{r.text}"</blockquote>
              <figcaption class="mt-4 flex items-center gap-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[var(--color-navy)] text-xs font-bold text-white">
                  {r.name.split(" ").map((p) => p[0]).join("").slice(0, 2)}
                </span>
                <span class="text-sm font-semibold text-[var(--color-navy)]">{r.name}</span>
                <GoogleLogo class="ml-auto h-4 w-4" />
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Rheem + financing -->
    <section class="bg-white py-14">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 md:grid-cols-2">
        <div class="flex gap-5 rounded-2xl p-6 ring-1 ring-[var(--color-line)]">
          <img src={img.rheem} alt="Rheem logo" width="104" height="104" loading="lazy" class="h-14 w-14 shrink-0" />
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-red-700">Rheem® Pro Partner</p>
            <h3 class="mt-1 text-lg font-bold text-[var(--color-navy)]">Factory-authorized in Wesley Chapel</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">Factory-trained installers, warranty registration on every Rheem system we install, and Rheem parts on the truck.</p>
          </div>
        </div>
        <div class="flex gap-5 rounded-2xl p-6 ring-1 ring-[var(--color-line)]">
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-[var(--color-navy)] text-white"><Icon name="dollar" class="h-6 w-6" /></span>
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-brand-dark)]">Financing available</p>
            <h3 class="mt-1 text-lg font-bold text-[var(--color-navy)]">New system, monthly payments</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">If it's time to replace, ask about financing when you call. We'll walk you through the options.</p>
            <img src={img.synchrony} alt="Synchrony financing partner" width="450" height="160" loading="lazy" class="mt-3 h-8 w-auto" />
          </div>
        </div>
      </div>
    </section>

    <!-- Service areas -->
    <section class="bg-[var(--color-brand-lighter)] py-16 sm:py-20">
      <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
        <div>
          <p class={eyebrow}>Where we work</p>
          <h2 class={h2}>Serving Wesley Chapel and the Tampa Bay area</h2>
          <p class="mt-4 leading-relaxed text-[var(--color-ink-soft)]">
            Based on Foamflower Blvd in Wesley Chapel, we cover Pasco, Hillsborough and Polk counties. Homes closest to the shop, like {neighborhoods.join(", ")}, get the earliest open times.
          </p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {areas.map((a) => (
              <li class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold text-[var(--color-navy)] ring-1 ring-[var(--color-line)]">
                <Icon name="check" class="h-3.5 w-3.5 text-[var(--color-brand)]" />{a}
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-[var(--color-ink-soft)]">Not sure we cover you? <a href={biz.phoneHref} class="font-semibold text-[var(--color-brand-dark)] underline" data-call="areas">Call {biz.phone}</a> and ask.</p>
        </div>
        <div class="overflow-hidden rounded-2xl shadow-sm ring-1 ring-[var(--color-line)]">
          <iframe
            title="I Care Air Care on Google Maps"
            src="https://maps.google.com/maps?q=I%20Care%20Air%20Care%2C%2027022%20Foamflower%20Blvd%2C%20Wesley%20Chapel%2C%20FL%2033544&z=10&output=embed"
            class="h-80 w-full lg:h-[26rem]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-white py-16 sm:py-20">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <div class="text-center">
          <p class={eyebrow}>Questions</p>
          <h2 class={h2}>Before you call</h2>
        </div>
        <div class="mt-10 divide-y divide-[var(--color-line)] rounded-2xl ring-1 ring-[var(--color-line)]">
          {faqs.map((f, i) => (
            <details class="group px-5 py-1 sm:px-6" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold text-[var(--color-navy)]">
                {f.q}
                <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-[var(--color-brand)] transition-transform group-open:rotate-180" />
              </summary>
              <p class="pb-5 text-[15px] leading-relaxed text-[var(--color-ink-soft)]">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Form + call -->
    <section id="callback" class="relative isolate scroll-mt-20 overflow-hidden bg-[var(--color-navy)] py-16 text-white sm:py-20">
      <div class="absolute inset-0 -z-10 bg-gradient-to-br from-[var(--color-navy-deep)] via-[var(--color-navy)] to-[var(--color-brand-dark)]"></div>
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-accent-light)]">Fastest way: call</p>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Talk to our Wesley Chapel office now</h2>
          <p class="mt-4 max-w-lg leading-relaxed text-white/80">
            Tell us what your system is doing and we'll book the earliest open time. Can't talk right now? Leave your number and we'll call you.
          </p>
          <a href={biz.phoneHref} class={`${callBtn} mt-7 w-full px-7 py-4 text-xl sm:w-auto`} data-call="callback">
            <Icon name="phone" class="h-6 w-6" />Call {biz.phone}
          </a>
          <div class="mt-8 space-y-2 text-sm text-white/75">
            <p class="flex items-start gap-2"><Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent-light)]" />{biz.hours}</p>
            <p class="flex items-start gap-2"><Icon name="home" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent-light)]" />{biz.street}, {biz.cityLine}</p>
          </div>
        </div>
        <LeadForm formId="callback-form" />
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-[var(--color-navy-deep)] pb-28 pt-10 text-sm text-white/65 md:pb-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-4">
        <span class="rounded-lg bg-white p-2"><img src={img.logo} alt="I Care Air Care" width="240" height="136" loading="lazy" class="h-10 w-auto" /></span>
        <div class="leading-relaxed">
          <p class="font-semibold text-white">I Care Air Care LLC</p>
          <p>{biz.street}, {biz.cityLine} · <a href={biz.phoneHref} class="text-white underline" data-call="footer">{biz.phone}</a></p>
          <p>Florida state certified HVAC contractor {biz.license}</p>
        </div>
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a href={biz.siteUrl} class="hover:text-white">icareaircare.com</a>
        <a href={biz.bbbUrl} target="_blank" rel="noopener" class="hover:text-white">BBB profile</a>
        <a href={biz.privacyUrl} class="hover:text-white">Privacy policy</a>
        <span>© {new Date().getFullYear()} I Care Air Care</span>
      </div>
    </div>
  </footer>

  <!-- Mobile sticky call bar -->
  <div class="fixed inset-x-0 bottom-0 z-50 border-t border-black/10 bg-white/95 p-3 shadow-[0_-8px_24px_-12px_rgb(15_26_41/0.35)] backdrop-blur md:hidden" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
    <div class="flex gap-2">
      <a href={biz.phoneHref} class={`${callBtn} flex-1 px-4 py-3.5 text-base`} data-call="sticky">
        <Icon name="phone" class="h-5 w-5" />Call {biz.phone}
      </a>
      <a href="#callback" class="pop-btn inline-flex items-center justify-center rounded-lg bg-[var(--color-navy)] px-4 py-3.5 text-sm font-semibold text-white">Callback</a>
    </div>
  </div>

  <script>
    // Tell GTM which call button was tapped (header, hero, sticky...).
    document.querySelectorAll<HTMLAnchorElement>("a[data-call]").forEach((a) => {
      a.addEventListener("click", () => {
        const w = window as unknown as { dataLayer?: unknown[] };
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({ event: "call_click", call_location: a.dataset.call });
      });
    });
  </script>
</LandingLayout>
